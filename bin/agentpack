#!/usr/bin/env bash
# agentpack CLI entry point. Needs python3 >= 3.11 and PyYAML.
set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
export PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}"

# Pick the first interpreter that meets the version floor and can import PyYAML.
# Neither half can be assumed: Amazon Linux 2023's `python3` is 3.9, and a 3.12
# alongside it may have no PyYAML while a repo-local virtualenv does. A host whose
# only `python3` is too old otherwise fails on `tomllib` before it can say so.
probe='import sys, yaml; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)'
args=("$@")
try() {
  candidate="$1"
  if [ -x "$candidate" ] || command -v "$candidate" >/dev/null 2>&1; then
    if "$candidate" -c "$probe" 2>/dev/null; then
      exec "$candidate" -m agentpack "${args[@]}"
    fi
  fi
  return 1
}

candidates=("$here/.venv/bin/python" python3 python3.13 python3.12 python3.11)
for candidate in "${candidates[@]}"; do
  try "$candidate" || true
done

echo "agentpack: no interpreter with python >= 3.11 and PyYAML" >&2
echo "agentpack: tried ${candidates[*]}" >&2
exit 1
